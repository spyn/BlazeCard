{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BlazeCard": {
    "PreviewDebounceMs": 100,
    "SnippetEmitDebounceMs": 200,
    "CodeParseDebounceMs": 500,
    "MaxImageSizeBytes": 5242880,
    "DefaultLanguage": "en-AU",
    "SessionStorageKey": "blazecard.session.v1",
    "PkPass": {
      "Enabled": true,
      "UsePreviewCertificates": true,
      "PassTypeIdentifier": "pass.com.example.blazecard",
      "TeamIdentifier": "TEAMID"
    }
  }
}
