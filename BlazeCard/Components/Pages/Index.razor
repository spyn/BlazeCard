@page "/"
@implements IDisposable
@inject IBlazeCardStateService State
@inject ISessionRestoreService SessionRestore
@inject ISnackbar Snackbar

<div class="blaze-shell">
    <section class="blaze-shell__editor">
        <div class="editor-toolbar">
            <nav class="editor-tabs" aria-label="Editor mode">
                <button type="button"
                        class="editor-tab @(State.CurrentMode == AppMode.Form ? "editor-tab--active" : null)"
                        @onclick="@(() => State.SetMode(AppMode.Form))">Visual</button>
                <button type="button"
                        class="editor-tab @(State.CurrentMode == AppMode.Code ? "editor-tab--active" : null)"
                        @onclick="@(() => State.SetMode(AppMode.Code))">Code</button>
            </nav>
            <button type="button" class="editor-revert" @onclick="RevertAsync" title="Reload saved session">
                <MudIcon Icon="@Icons.Material.Outlined.Replay" Size="Size.Small" />
                Revert Changes
            </button>
        </div>

        <div class="editor-body">
            @if (State.CurrentMode == AppMode.Code)
            {
                <CodeMode />
            }
            else
            {
                <FormMode ShowFooterActions="false" />
            }
        </div>

        @if (State.CurrentMode == AppMode.Form)
        {
            <div class="editor-footer">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="editor-footer__preset"
                           OnClick="@(() => State.ApplyPreset("sample-member"))">
                    Apply Sample Preset
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="editor-footer__build"
                           OnClick="BuildAsync">
                    Build
                </MudButton>
            </div>
        }
    </section>

    <aside class="blaze-shell__preview">
        <PreviewPanel />
    </aside>
</div>

@code {
    private bool _restored;

    protected override void OnInitialized()
    {
        if (State.PreviewFocus == PreviewFocus.Dual)
            State.SetPreviewFocus(PreviewFocus.Apple);
        State.OnStateChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _restored) return;
        _restored = true;
        try
        {
            var loaded = await SessionRestore.TryLoadAsync();
            if (loaded is { Card: not null } value)
                ApplyLoaded(value.Card!, value.Skin, value.Appearance);
        }
        catch
        {
            // first visit / no storage
        }
    }

    private void ApplyLoaded(CardModel src, Skin skin, AppearanceMode appearance)
    {
        State.UpdateCard(c =>
        {
            c.Description = src.Description;
            c.OrganizationName = src.OrganizationName;
            c.LogoText = src.LogoText;
            c.BackgroundColor = src.BackgroundColor;
            c.LabelColor = src.LabelColor;
            c.ForegroundColor = src.ForegroundColor;
            c.HeaderFields = src.HeaderFields;
            c.PrimaryFields = src.PrimaryFields;
            c.SecondaryFields = src.SecondaryFields;
            c.AuxiliaryFields = src.AuxiliaryFields;
            c.BackFields = src.BackFields;
            c.BarcodeFormat = src.BarcodeFormat;
            c.BarcodeMessage = src.BarcodeMessage;
            c.BarcodeAltText = src.BarcodeAltText;
            c.DefaultLanguage = src.DefaultLanguage;
            c.PassType = src.PassType;
        });
        State.SetSkin(skin);
        State.SetAppearance(appearance);
    }

    private async Task RevertAsync()
    {
        var loaded = await SessionRestore.TryLoadAsync();
        if (loaded?.Card is null)
        {
            Snackbar.Add("No saved session to revert to.", Severity.Warning);
            return;
        }
        ApplyLoaded(loaded.Value.Card!, loaded.Value.Skin, loaded.Value.Appearance);
        Snackbar.Add("Reverted to saved session.", Severity.Info);
    }

    private async Task BuildAsync()
    {
        await SessionRestore.SaveAsync(State.Card, State.Skin, State.Appearance);
        var result = await State.BuildAsync();
        if (result.Success)
            Snackbar.Add("Build OK — snippets re-synced.", Severity.Success);
        else
            foreach (var err in result.ValidationErrors)
                Snackbar.Add(err, Severity.Error);
    }

    public void Dispose() => State.OnStateChanged -= StateHasChanged;
}
