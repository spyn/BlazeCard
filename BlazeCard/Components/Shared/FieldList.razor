@implements IDisposable
@inject IBlazeCardStateService State

<div class="mb-2">
    <div class="d-flex align-center justify-space-between mb-1">
        <MudText Typo="Typo.subtitle2">
            @Title
            @if (MaxItems is > 0)
            {
                <span class="mud-text-secondary"> (max @MaxItems)</span>
            }
        </MudText>
        <MudButton Size="Size.Small"
                   Variant="Variant.Text"
                   Disabled="@AtCapacity"
                   OnClick="Add">
            Add field
        </MudButton>
    </div>
    @foreach (var field in Fields)
    {
        <FieldEditor Group="Group" Field="field" />
    }
    @if (!Fields.Any())
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">No fields yet — click Add field.</MudText>
    }
</div>

@code {
    [Parameter] public FieldGroup Group { get; set; }
    [Parameter] public string Title { get; set; } = "Fields";
    [Parameter] public int? MaxItems { get; set; }

    private List<PassField> GroupFields => Group switch
    {
        FieldGroup.Header => State.Card.HeaderFields,
        FieldGroup.Primary => State.Card.PrimaryFields,
        FieldGroup.Secondary => State.Card.SecondaryFields,
        FieldGroup.Auxiliary => State.Card.AuxiliaryFields,
        FieldGroup.Back => State.Card.BackFields,
        _ => []
    };

    private IEnumerable<PassField> Fields => GroupFields;
    private bool AtCapacity => MaxItems is int max && GroupFields.Count >= max;

    protected override void OnInitialized() => State.OnStateChanged += StateHasChanged;
    public void Dispose() => State.OnStateChanged -= StateHasChanged;

    private void Add()
    {
        if (AtCapacity) return;
        State.AddField(Group);
    }
}
