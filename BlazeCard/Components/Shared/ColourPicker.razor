<div class="mb-2">
    <MudTextField T="string" Label="@Label" Value="@Value" ValueChanged="OnChanged" Immediate="true"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Palette" />
</div>

@code {
    [Parameter] public string Label { get; set; } = "Colour";
    [Parameter] public string Value { get; set; } = "#000000";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private async Task OnChanged(string v) => await ValueChanged.InvokeAsync(v ?? "#000000");
}
