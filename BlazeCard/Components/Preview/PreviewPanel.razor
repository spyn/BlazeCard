@implements IDisposable
@inject IBlazeCardStateService State

<div class="preview-panel">
    <div class="preview-panel__header">
        <span class="preview-panel__label">Preview</span>
        <div class="preview-panel__tools">
            <button type="button"
                    class="preview-flip-btn @(_showBack ? "preview-flip-btn--active" : null)"
                    aria-pressed="@(_showBack ? "true" : "false")"
                    @onclick="ToggleFlip">@(_showBack ? "Front" : "Flip")</button>
            <div class="preview-segment" role="group" aria-label="Preview platform">
                <button type="button"
                        class="preview-segment__btn @(State.PreviewFocus == PreviewFocus.Apple ? "preview-segment__btn--active" : null)"
                        @onclick="@(() => SelectPlatform(PreviewFocus.Apple))">Apple</button>
                <button type="button"
                        class="preview-segment__btn @(State.PreviewFocus == PreviewFocus.Google ? "preview-segment__btn--active" : null)"
                        @onclick="@(() => SelectPlatform(PreviewFocus.Google))">Google</button>
            </div>
        </div>
    </div>

    <div class="preview-stage">
        <div class="phone-frame @(State.PreviewFocus == PreviewFocus.Google ? "phone-frame--android" : null)">
            <div class="phone-frame__notch" aria-hidden="true"></div>
            <div class="phone-frame__screen">
                @if (State.PreviewFocus == PreviewFocus.Google)
                {
                    <GoogleCardPreview Card="State.Card" ShowBack="_showBack" OnFlip="ToggleFlip" />
                }
                else
                {
                    <AppleCardPreview Card="State.Card" ShowBack="_showBack" OnFlip="ToggleFlip" />
                }
            </div>
            <div class="phone-frame__home" aria-hidden="true"></div>
        </div>
    </div>
</div>

@code {
    private bool _showBack;

    protected override void OnInitialized() => State.OnStateChanged += StateHasChanged;
    public void Dispose() => State.OnStateChanged -= StateHasChanged;

    private void ToggleFlip() => _showBack = !_showBack;

    private void SelectPlatform(PreviewFocus focus)
    {
        _showBack = false;
        State.SetPreviewFocus(focus);
    }
}
