@using Passbook.Generator

@if (Card is null) { return; }

@{
    var logo = Card.GetPassbookPreview(PassbookImage.Logo3X, PassbookImage.Logo2X, PassbookImage.Logo);
    var strip = Card.GetPassbookPreview(PassbookImage.Strip3X, PassbookImage.Strip2X, PassbookImage.Strip);
    var background = Card.GetPassbookPreview(PassbookImage.Background3X, PassbookImage.Background2X, PassbookImage.Background);
    var thumbnail = Card.GetPassbookPreview(PassbookImage.Thumbnail3X, PassbookImage.Thumbnail2X, PassbookImage.Thumbnail);
    var footer = Card.GetPassbookPreview(PassbookImage.Footer3X, PassbookImage.Footer2X, PassbookImage.Footer);
    var faceStyle = string.IsNullOrEmpty(background)
        ? $"background-color: {Card.BackgroundColor}; color: {Card.ForegroundColor}"
        : $"background-color: {Card.BackgroundColor}; color: {Card.ForegroundColor}; background-image: url('{background}'); background-size: cover; background-position: center";
}

<div class="apple-pass apple-pass--generic" style="@faceStyle">
    <div class="apple-pass__header">
        <div class="apple-pass__logo-area">
            @if (!string.IsNullOrEmpty(logo))
            {
                <img class="apple-pass__logo-img" src="@logo" alt="logo" />
            }
            <span class="apple-pass__logo-text">@Card.LogoText</span>
        </div>
        @foreach (var f in Card.HeaderFields)
        {
            <div class="apple-pass__header-field">
                <div class="apple-pass__field-label" style="color:@Card.LabelColor">@f.Label</div>
                <div class="apple-pass__field-value">@f.Value</div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(strip))
    {
        <div class="apple-pass__strip">
            <img class="apple-pass__strip-img" src="@strip" alt="strip" />
            @PrimaryFields
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(thumbnail))
        {
            <div class="apple-pass__thumb-wrap">
                <img class="apple-pass__thumb" src="@thumbnail" alt="thumbnail" />
            </div>
        }
        @PrimaryFields
    }

    <div class="apple-pass__secondary-fields">
        @foreach (var f in Card.SecondaryFields.Concat(Card.AuxiliaryFields))
        {
            <div class="apple-pass__secondary-field">
                <div class="apple-pass__field-label" style="color:@Card.LabelColor">@f.Label</div>
                <div class="apple-pass__field-value">@f.Value</div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(footer))
    {
        <div class="apple-pass__footer">
            <img class="apple-pass__footer-img" src="@footer" alt="footer" />
        </div>
    }

    @if (Card.BarcodeFormat != BarcodeFormat.None)
    {
        <div class="apple-pass__barcode-area">
            @if (Card.BarcodeFormat == BarcodeFormat.QR && !string.IsNullOrWhiteSpace(Card.BarcodeMessage))
            {
                <QrBarcodeGlyph Message="@Card.BarcodeMessage" />
            }
            else
            {
                <div class="apple-pass__barcode-placeholder">
                    <div class="apple-pass__barcode-icon">▮▮▮</div>
                    <div class="apple-pass__barcode-text">@Card.BarcodeMessage</div>
                    <div class="apple-pass__barcode-text">Only QR is scannable in preview</div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CardModel Card { get; set; } = default!;

    private RenderFragment PrimaryFields => @<div class="apple-pass__primary-fields">
        @foreach (var f in Card.PrimaryFields)
        {
            <div>
                <div class="apple-pass__field-label" style="color:@Card.LabelColor">@f.Label</div>
                <div class="apple-pass__field-value apple-pass__field-value--primary">@f.Value</div>
            </div>
        }
    </div>;
}
