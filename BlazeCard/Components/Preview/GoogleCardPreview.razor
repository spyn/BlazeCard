@using Passbook.Generator

@if (Card is null) { return; }

@{
    var logo = Card.GetPassbookPreview(PassbookImage.Logo3X, PassbookImage.Logo2X, PassbookImage.Logo);
    var useWide = !string.IsNullOrEmpty(Card.WideLogoImage);
}

<div class="google-card" style="background-color: @Card.BackgroundColor; color: @Card.ForegroundColor">
    <div class="google-card__top-bar">
        @if (useWide)
        {
            <img class="google-card__wide-logo" src="@Card.WideLogoImage" alt="wide logo" />
        }
        else if (!string.IsNullOrEmpty(logo))
        {
            <img class="google-card__logo" src="@logo" alt="logo" />
        }
        else
        {
            <div class="google-card__logo-fallback" aria-hidden="true">@LogoInitial</div>
        }
        <span class="google-card__org-name">@Card.OrganizationName</span>
    </div>

    @if (!string.IsNullOrEmpty(Card.HeroImage))
    {
        <div class="google-card__hero">
            <img class="google-card__hero-img" src="@Card.HeroImage" alt="hero" />
        </div>
    }

    <div class="google-card__title-block">
        @{
            var primary = Card.PrimaryFields.FirstOrDefault();
            var header = FirstNonEmpty(primary?.Value, Card.LogoText, Card.Description, "Generic pass");
        }
        @if (!string.IsNullOrWhiteSpace(primary?.Label))
        {
            <div class="google-card__subheader">@primary.Label</div>
        }
        <div class="google-card__header">@header</div>
    </div>

    @foreach (var f in Card.SecondaryFields.Concat(Card.AuxiliaryFields).Concat(Card.BackFields.Where(f => !IsLink(f.Value))))
    {
        <div class="google-card__row">
            <span class="google-card__row-label">@f.Label</span>
            <span>@f.Value</span>
        </div>
    }

    @foreach (var f in Card.BackFields.Where(f => IsLink(f.Value)))
    {
        <div class="google-card__row google-card__row--link">
            <span class="google-card__row-label">@f.Label</span>
            <span>@f.Value</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Card.ImageModuleImage))
    {
        <div class="google-card__module">
            <img class="google-card__module-img" src="@Card.ImageModuleImage" alt="image module" />
        </div>
    }

    @if (Card.BarcodeFormat != BarcodeFormat.None)
    {
        <div class="google-card__barcode-strip">
            @if (Card.BarcodeFormat == BarcodeFormat.QR && !string.IsNullOrWhiteSpace(Card.BarcodeMessage))
            {
                <QrBarcodeGlyph Message="@Card.BarcodeMessage" />
            }
            else
            {
                <div class="google-card__barcode-placeholder">▮▮▮</div>
                <div class="google-card__barcode-value">@Card.BarcodeMessage</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CardModel Card { get; set; } = default!;

    private string LogoInitial
    {
        get
        {
            var title = Card.OrganizationName;
            return string.IsNullOrWhiteSpace(title) ? "?" : char.ToUpperInvariant(title.Trim()[0]).ToString();
        }
    }

    private static bool IsLink(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var v = value.Trim();
        return v.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || v.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || v.StartsWith("tel:", StringComparison.OrdinalIgnoreCase)
            || v.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase);
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? string.Empty;
}
