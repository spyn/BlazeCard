@implements IDisposable
@inject IBlazeCardStateService State
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-3">Form Mode</MudText>

<MudExpansionPanels MultiExpansion="true">
    <MudExpansionPanel Text="Pass Details" Expanded="true">
        <MudTextField T="string" Label="Pass Type" Value="@PassTypeLabel" Disabled="true" Class="mb-2" />
        <MudTextField T="string" Label="Description" Value="@State.Card.Description"
                      ValueChanged="OnDescription" Immediate="true" Class="mb-2" />
        <MudTextField T="string" Label="Organisation Name" Value="@State.Card.OrganizationName"
                      ValueChanged="OnOrg" Immediate="true" Class="mb-2" />
        <MudTextField T="string" Label="Logo Text" Value="@State.Card.LogoText"
                      ValueChanged="OnLogoText" Immediate="true" Class="mb-2" />
        <MudTextField T="string" Label="Default Language" Value="@State.Card.DefaultLanguage"
                      ValueChanged="OnLang" Immediate="true" />
    </MudExpansionPanel>

    <MudExpansionPanel Text="Appearance">
        <ColourPicker Label="Background" Value="@State.Card.BackgroundColor"
                      ValueChanged="OnBg" />
        <ColourPicker Label="Label" Value="@State.Card.LabelColor"
                      ValueChanged="OnLabel" />
        <ColourPicker Label="Foreground" Value="@State.Card.ForegroundColor"
                      ValueChanged="OnFg" />
    </MudExpansionPanel>

    <MudExpansionPanel Text="Images">
        <ImageUploader Slot="ImageSlot.Logo" Label="Logo" RecommendedWidth="160" RecommendedHeight="50" />
        <ImageUploader Slot="ImageSlot.Icon" Label="Icon" RecommendedWidth="58" RecommendedHeight="58" />
        <ImageUploader Slot="ImageSlot.Strip" Label="Strip" RecommendedWidth="640" RecommendedHeight="246" />
        <ImageUploader Slot="ImageSlot.Hero" Label="Hero" RecommendedWidth="1125" RecommendedHeight="432" />
        <ImageUploader Slot="ImageSlot.Thumbnail" Label="Thumbnail" RecommendedWidth="660" RecommendedHeight="660" />
    </MudExpansionPanel>

    <MudExpansionPanel Text="Pass Fields" Expanded="true">
        <FieldList Group="FieldGroup.Header" Title="Header (max 1)" />
        <FieldList Group="FieldGroup.Primary" Title="Primary (max 2)" />
        <FieldList Group="FieldGroup.Secondary" Title="Secondary" />
        <FieldList Group="FieldGroup.Auxiliary" Title="Auxiliary" />
        <FieldList Group="FieldGroup.Back" Title="Back" />
    </MudExpansionPanel>

    <MudExpansionPanel Text="Barcode">
        <BarcodeConfig />
    </MudExpansionPanel>
</MudExpansionPanels>

<div class="mt-4 d-flex gap-2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BuildAsync">Build</MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="ApplyPreset">Apply HBF Member Preset</MudButton>
</div>

@code {
    private static string PassTypeLabel => "Generic";

    protected override void OnInitialized() => State.OnStateChanged += StateHasChanged;
    public void Dispose() => State.OnStateChanged -= StateHasChanged;

    private void OnDescription(string v) => State.UpdateCard(c => c.Description = v ?? "");
    private void OnOrg(string v) => State.UpdateCard(c => c.OrganizationName = v ?? "");
    private void OnLogoText(string v) => State.UpdateCard(c => c.LogoText = v ?? "");
    private void OnLang(string v) => State.UpdateCard(c => c.DefaultLanguage = string.IsNullOrWhiteSpace(v) ? "en-AU" : v);
    private void OnBg(string v) => State.UpdateCard(c => c.BackgroundColor = v);
    private void OnLabel(string v) => State.UpdateCard(c => c.LabelColor = v);
    private void OnFg(string v) => State.UpdateCard(c => c.ForegroundColor = v);
    private void ApplyPreset() => State.ApplyPreset("hbf-member");

    private async Task BuildAsync()
    {
        var result = await State.BuildAsync();
        if (result.Success)
            Snackbar.Add("Build OK — snippets re-synced. Open Code Mode to copy.", Severity.Success);
        else
            foreach (var err in result.ValidationErrors)
                Snackbar.Add(err, Severity.Error);
    }
}
