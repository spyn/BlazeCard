@implements IDisposable
@inject IBlazeCardStateService State

<div class="form-mode">
    <MudExpansionPanels MultiExpansion="true" Class="bc-accordions" Elevation="0">
        <MudExpansionPanel Text="Pass Details" Expanded="true" Gutters="true">
            <div class="form-grid form-grid--2">
                <MudSelect T="string" Label="Pass Type" Value="@PassTypeLabel" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@PassTypeLabel">Generic</MudSelectItem>
                </MudSelect>
                <MudTextField T="string" Label="Language" Value="@State.Card.DefaultLanguage"
                              ValueChanged="OnLang" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <MudTextField T="string" Label="Description" Value="@State.Card.Description"
                          ValueChanged="OnDescription" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
            <MudTextField T="string" Label="Organization Name" Value="@State.Card.OrganizationName"
                          ValueChanged="OnOrg" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
            <MudTextField T="string" Label="Logo Text" Value="@State.Card.LogoText"
                          ValueChanged="OnLogoText" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
            <MudSelect T="string" Label="Google genericType" Value="@State.Card.GoogleGenericType"
                       ValueChanged="OnGenericType" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
                @foreach (var t in GoogleGenericTypes.All)
                {
                    <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                }
            </MudSelect>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Appearance" Expanded="true">
            <ColourPicker Label="Background" Value="@State.Card.BackgroundColor" ValueChanged="OnBg" />
            <ColourPicker Label="Label" Value="@State.Card.LabelColor" ValueChanged="OnLabel" />
            <ColourPicker Label="Foreground" Value="@State.Card.ForegroundColor" ValueChanged="OnFg" />
            <MudCheckBox T="bool" Label="Suppress strip shine"
                         Value="@State.Card.SuppressStripShine" ValueChanged="OnSuppressShine"
                         Dense="true" Class="mt-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Apple’s only strip display flag (<code>SuppressStripShine</code>). Wallet still cover-crops the image — there is no stretch option in dotnet-passbook.
            </MudText>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Apple Passbook Images">
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                Drag images into each slot. Maps to <code>PassbookImage</code> /
                <code>request.Images.Add(...)</code> in the Apple snippet.
                Strip artwork is cover-cropped to the slot — Wallet and dotnet-passbook have no stretch flag.
            </MudText>
            @foreach (var group in PassbookImageCatalog.AppleGroups)
            {
                <PassbookImageGroup Group="group" />
            }
        </MudExpansionPanel>

        <MudExpansionPanel Text="Google Images">
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                GenericObject image fields. Snippets use HTTPS placeholders; Live Preview uses your uploads.
                Circular <code>logo</code> is driven by Apple Logo slots above.
            </MudText>
            <ImageUploader GoogleSlot="GoogleImageSlot.Hero" Label="Hero" RecommendedWidth="1032" RecommendedHeight="336" ScaleLabel="Google" />
            <ImageUploader GoogleSlot="GoogleImageSlot.WideLogo" Label="Wide logo" RecommendedWidth="1280" RecommendedHeight="400" ScaleLabel="Google" />
            <ImageUploader GoogleSlot="GoogleImageSlot.ImageModule" Label="Image module (mainImage)" RecommendedWidth="1860" RecommendedHeight="600" ScaleLabel="Google" />
        </MudExpansionPanel>

        <MudExpansionPanel Text="Pass Fields" Expanded="true">
            <FieldList Group="FieldGroup.Header" Title="Header (max 1)" />
            <FieldList Group="FieldGroup.Primary" Title="Primary (max 2)" />
            <FieldList Group="FieldGroup.Secondary" Title="Secondary" />
            <FieldList Group="FieldGroup.Auxiliary" Title="Auxiliary" />
            <FieldList Group="FieldGroup.Back" Title="Back" />
        </MudExpansionPanel>

        <MudExpansionPanel Text="Barcode">
            <BarcodeConfig />
        </MudExpansionPanel>
    </MudExpansionPanels>

    @if (ShowFooterActions)
    {
        <div class="mt-4 d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplyPreset">Apply Sample Preset</MudButton>
        </div>
    }
</div>

@code {
    [Parameter] public bool ShowFooterActions { get; set; } = true;

    private static string PassTypeLabel => "Generic";

    protected override void OnInitialized() => State.OnStateChanged += StateHasChanged;
    public void Dispose() => State.OnStateChanged -= StateHasChanged;

    private void OnDescription(string v) => State.UpdateCard(c => c.Description = v ?? "");
    private void OnOrg(string v) => State.UpdateCard(c => c.OrganizationName = v ?? "");
    private void OnLogoText(string v) => State.UpdateCard(c => c.LogoText = v ?? "");
    private void OnGenericType(string v) => State.UpdateCard(c =>
        c.GoogleGenericType = string.IsNullOrWhiteSpace(v) ? "GENERIC_TYPE_UNSPECIFIED" : v);
    private void OnLang(string v) => State.UpdateCard(c => c.DefaultLanguage = string.IsNullOrWhiteSpace(v) ? "en-AU" : v);
    private void OnBg(string v) => State.UpdateCard(c => c.BackgroundColor = v);
    private void OnLabel(string v) => State.UpdateCard(c => c.LabelColor = v);
    private void OnFg(string v) => State.UpdateCard(c => c.ForegroundColor = v);
    private void OnSuppressShine(bool v) => State.UpdateCard(c => c.SuppressStripShine = v);
    private void ApplyPreset() => State.ApplyPreset("sample-member");
}
