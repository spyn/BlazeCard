@implements IDisposable
@inject IBlazeCardStateService State

<div class="workspace-sidebar">
    <MudList T="string" Dense="true">
        <MudListItem T="string" Icon="@Icons.Material.Filled.EditNote" OnClick="@(() => State.SetMode(AppMode.Form))"
                     Class="@(State.CurrentMode == AppMode.Form ? "mud-selected-item" : null)">Form</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Code" OnClick="@(() => State.SetMode(AppMode.Code))"
                     Class="@(State.CurrentMode == AppMode.Code ? "mud-selected-item" : null)">Code</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.DashboardCustomize" OnClick="@(() => State.SetMode(AppMode.Visual))"
                     Class="@(State.CurrentMode == AppMode.Visual ? "mud-selected-item" : null)">Visual</MudListItem>
    </MudList>

    <MudDivider Class="my-3" />

    <MudText Typo="Typo.caption" Class="px-4 mud-text-secondary">Preset</MudText>
    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mx-2" OnClick="@(() => State.ApplyPreset("hbf-member"))">
        HBF Member
    </MudButton>

    <SkinAppearanceControls />

    <MudDivider Class="my-3" />
    <MudText Typo="Typo.caption" Class="px-4 mud-text-secondary">Session Restore</MudText>
    <div class="px-2 d-flex flex-column gap-1">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="OnSessionExport">Save session</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="OnSessionImport">Load session</MudButton>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSessionExport { get; set; }
    [Parameter] public EventCallback OnSessionImport { get; set; }

    protected override void OnInitialized() => State.OnStateChanged += StateHasChanged;
    public void Dispose() => State.OnStateChanged -= StateHasChanged;
}
