<div class="visual-toolbox">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Toolbox</MudText>
    <MudText Typo="Typo.caption">Fields</MudText>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ma-1" OnClick="@(() => OnAdd.InvokeAsync(ToolboxItemType.HeaderField))">Header</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ma-1" OnClick="@(() => OnAdd.InvokeAsync(ToolboxItemType.PrimaryField))">Primary</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ma-1" OnClick="@(() => OnAdd.InvokeAsync(ToolboxItemType.SecondaryField))">Secondary</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ma-1" OnClick="@(() => OnAdd.InvokeAsync(ToolboxItemType.AuxiliaryField))">Auxiliary</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ma-1" OnClick="@(() => OnAdd.InvokeAsync(ToolboxItemType.BackField))">Back</MudButton>
    <MudText Typo="Typo.caption" Class="mt-2">Other</MudText>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ma-1" OnClick="@(() => OnAdd.InvokeAsync(ToolboxItemType.Barcode))">Barcode</MudButton>
</div>

@code {
    [Parameter] public EventCallback<ToolboxItemType> OnAdd { get; set; }
}
