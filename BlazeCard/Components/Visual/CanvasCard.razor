@implements IDisposable
@inject IBlazeCardStateService State

<div class="visual-canvas" style="background:@State.Card.BackgroundColor;color:@State.Card.ForegroundColor">
    <DropZone ZoneId="DropZoneId.Header" Label="Header" MaxItems="1" />
    <DropZone ZoneId="DropZoneId.Primary" Label="Primary" MaxItems="2" />
    <DropZone ZoneId="DropZoneId.Secondary" Label="Secondary" MaxItems="8" />
    <DropZone ZoneId="DropZoneId.Auxiliary" Label="Auxiliary" MaxItems="8" />
    <DropZone ZoneId="DropZoneId.Back" Label="Back" MaxItems="12" />
    <DropZone ZoneId="DropZoneId.Barcode" Label="Barcode" MaxItems="1" />
</div>

@code {
    protected override void OnInitialized() => State.OnStateChanged += StateHasChanged;
    public void Dispose() => State.OnStateChanged -= StateHasChanged;
}
