@inherits LayoutComponentBase
@implements IDisposable
@inject IBlazeCardStateService State

<MudThemeProvider Theme="_theme" IsDarkMode="@(State.Appearance == AppearanceMode.Dark)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="bc-root" data-appearance="@State.Appearance.ToString().ToLowerInvariant()">
    <header class="bc-topbar">
        <div class="bc-brand">
            <span class="bc-brand__mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="28" height="28" fill="none">
                    <path d="M16 4l2.2 6.4H25l-5.3 3.9 2 6.4L16 17.6l-5.7 3.1 2-6.4L7 10.4h6.8L16 4z" fill="currentColor" opacity=".25"/>
                    <path d="M10 22c2.5-6 5-9.5 6-14 1 4.5 3.5 8 6 14-4-1.2-8-1.2-12 0z" fill="currentColor"/>
                    <path d="M14 22h4l1 5h-6l1-5z" fill="currentColor"/>
                </svg>
            </span>
            <span class="bc-brand__name">BlazeCard</span>
        </div>
        <div class="bc-topbar__actions">
            <SkinAppearanceControls Compact="true" />
            <button type="button" class="bc-icon-btn" title="Help" aria-label="Help">?</button>
            <span class="bc-avatar" title="Preview only" aria-hidden="true">BC</span>
        </div>
    </header>
    <main class="bc-main">
        @Body
    </main>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#E85A1C",
            Secondary = "#0D7377",
            AppbarBackground = "#FFFCF8",
            Background = "#F4F1EC",
            Surface = "#FFFFFF",
            TextPrimary = "#2C241C",
            TextSecondary = "#6F655C",
            DrawerBackground = "#FFFCF8",
            ActionDefault = "#6F655C"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#FF6A33",
            Secondary = "#14919B",
            AppbarBackground = "#1A1612",
            Background = "#14110E",
            Surface = "#1E1A16",
            TextPrimary = "#F5F0EA",
            TextSecondary = "#A89F94"
        }
    };

    protected override void OnInitialized() => State.OnStateChanged += StateHasChanged;

    public void Dispose() => State.OnStateChanged -= StateHasChanged;
}
